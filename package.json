{
  "name": "life-swipe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A darkly comic life-simulation game played entirely through binary swipe decisions.",
  "scripts": {
    "start": "npm run build && node server/index.js",
    "build": "vite build",
    "dev": "concurrently -k -n vite,api -c cyan,magenta \"vite\" \"node --watch server/index.js\"",
    "serve": "node server/index.js",
    "simulate": "node scripts/simulate.js",
    "extract-patterns": "node scripts/extract-patterns.js",
    "coverage": "node scripts/coverage.js",
    "names": "node scripts/name-check.js",
    "build-region-weights": "node scripts/build-region-weights.js",
    "build:admin": "vite build --config vite.admin.config.js",
    "admin": "npm run build:admin && node server/index.js",
    "dev:admin": "concurrently -k -n admin,api -c cyan,magenta \"vite --config vite.admin.config.js\" \"node --watch server/index.js\"",
    "normalise-content": "node scripts/normalise-content.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "geoip-lite": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.0"
  }
}

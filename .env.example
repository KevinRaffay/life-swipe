# Copy this file to .env and drop your key in.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional
PORT=8787
LIFESWIPE_MODEL=claude-sonnet-4-6

# Provider selection: "anthropic" (default) or "ollama" (a local Ollama
# instance). With ollama, OLLAMA_MODEL is required - there is no default,
# set it to a model you have pulled (see `ollama list`).
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen3-coder:30b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TIMEOUT_MS=120000
